# Diagnostic reports (Crashed Node apps)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Optional npm cache directory
.npm

# Output of 'pnpm pack'
*.tgz

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

